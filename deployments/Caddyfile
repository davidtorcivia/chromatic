# Chromatic Reverse Proxy Configuration
# Caddy automatically provisions TLS certificates via Let's Encrypt

{$DOMAIN:localhost} {
    # Enable compression
    encode gzip zstd

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        X-XSS-Protection "1; mode=block"
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    # WebSocket upgrade for /ws/*
    @websocket {
        header Connection *Upgrade*
        header Upgrade websocket
    }

    # Reverse proxy to Chromatic backend
    reverse_proxy chromatic:3000 {
        # WebSocket support
        header_up Connection {http.request.header.Connection}
        header_up Upgrade {http.request.header.Upgrade}

        # Timeouts for WebRTC signaling
        transport http {
            read_timeout 120s
            write_timeout 120s
        }
    }

    # Health check endpoint (no caching)
    @health path /health
    handle @health {
        reverse_proxy chromatic:3000
        header Cache-Control "no-cache, no-store, must-revalidate"
    }

    # Static assets caching
    @static path /assets/* /_app/*
    handle @static {
        reverse_proxy chromatic:3000
        header Cache-Control "public, max-age=31536000, immutable"
    }

    # Log requests (in production, consider logging to file)
    log {
        output stdout
        format json
        level INFO
    }
}

# Health check endpoint for Caddy itself
:8080 {
    respond /health "OK" 200
}
