# Required production identity
DOMAIN=stream.yourdomain.com
PUBLIC_URL=https://stream.yourdomain.com
ALLOWED_ORIGINS=https://stream.yourdomain.com

# Use an immutable tag such as ghcr.io/davidtorcivia/chromatic:sha-<commit>
# or a digest reference for rollback-safe deploys.
CHROMATIC_IMAGE=ghcr.io/davidtorcivia/chromatic:sha-<commit>

# Generate with: openssl rand -hex 32
ADMIN_TOKEN=replace-with-strong-random-token

# Required when enabling deployments/docker-compose.monitoring.yml.
# Generate with: openssl rand -base64 32
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-strong-random-password

# Production hardening
PRODUCTION_MODE=true

# TURN mode. Cloudflare TURN is the recommended production default.
TURN_MODE=external
TURN_CLOUDFLARE_KEY_ID=
TURN_CLOUDFLARE_API_TOKEN=
TURN_CLOUDFLARE_CREDENTIAL_TTL=3600
TURN_CLOUDFLARE_CREDENTIAL_SKEW=60

# Alternative external TURN provider credentials.
TURN_EXTERNAL_URLS=
TURN_EXTERNAL_USER=
TURN_EXTERNAL_PASS=

# Required only for TURN_MODE=self-hosted or hybrid.
TURN_SECRET=
TURN_REALM=

# Caddy runs on this Docker subnet in the production compose file.
TRUSTED_PROXIES=172.28.20.0/24
