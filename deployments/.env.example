# Chromatic Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# Admin authentication token (generate with: openssl rand -hex 32)
# This is used to log into the admin dashboard
ADMIN_TOKEN=

# Public URL for WebSocket and signaling (without trailing slash)
# This should match your public-facing domain
PUBLIC_URL=https://stream.yourdomain.com

# TURN server configuration for WebRTC NAT traversal
# Generate secret with: openssl rand -hex 32
TURN_SECRET=
TURN_REALM=stream.yourdomain.com

# =============================================================================
# PRODUCTION SETTINGS
# =============================================================================

# Enable production mode (enforces strict security)
# When true, ALLOWED_ORIGINS is required
PRODUCTION_MODE=true

# Allowed CORS origins (comma-separated)
# Required when PRODUCTION_MODE=true
ALLOWED_ORIGINS=https://stream.yourdomain.com

# =============================================================================
# CONTAINER IMAGE
# =============================================================================

# Production image to deploy (recommended: pin to immutable sha- tag or digest)
# Example tag pin: ghcr.io/davidtorcivia/chromatic:sha-<git-commit-sha>
# Example digest pin: ghcr.io/davidtorcivia/chromatic@sha256:<digest>
CHROMATIC_IMAGE=ghcr.io/davidtorcivia/chromatic:latest

# Trusted reverse proxy IPs/CIDRs (comma-separated)
# Used for correct client IP detection behind proxies
# Common values: 172.17.0.0/16 (Docker), 10.0.0.0/8 (private networks)
TRUSTED_PROXIES=

# =============================================================================
# STORAGE PATHS (Docker volume mounts)
# =============================================================================

# SQLite database file path
DATABASE_PATH=/data/chromatic.db

# File upload storage directory
UPLOAD_PATH=/data/files

# Logo storage directory
LOGO_PATH=/data/logos

# =============================================================================
# SERVER SETTINGS
# =============================================================================

# Server port (internal, behind reverse proxy)
PORT=3000

# Your server's public IP address (for TURN server)
# Required for WebRTC connectivity through firewalls
PUBLIC_IP=

# =============================================================================
# EXTERNAL TURN SERVER (Optional)
# =============================================================================

# Optional external TURN server as fallback (e.g., Twilio TURN)
# These can also be configured in the admin Settings page
TURN_EXTERNAL_URL=
TURN_EXTERNAL_USER=
TURN_EXTERNAL_PASS=

# =============================================================================
# TIMEOUTS
# =============================================================================

# How long to keep a room live after OBS disconnects
# Allows reconnection without ending the session
# Format: Go duration (e.g., 5m, 300s, 5m30s)
OBS_RECONNECT_TIMEOUT=5m

# WebSocket client ping interval
# Clients send ping every N seconds to keep connection alive
CLIENT_PING_INTERVAL=60s
