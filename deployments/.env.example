# Chromatic Environment Configuration

# Admin authentication (generate with: openssl rand -hex 32)
ADMIN_TOKEN=

# Public URL for WebSocket and signaling
PUBLIC_URL=https://stream.yourdomain.com

# TURN configuration (generate secret with: openssl rand -hex 32)
TURN_SECRET=
TURN_REALM=stream.yourdomain.com

# Your server's public IP address
PUBLIC_IP=

# Optional: External TURN fallback (e.g., Twilio)
TURN_EXTERNAL_URL=
TURN_EXTERNAL_USER=
TURN_EXTERNAL_PASS=

# Server port (default: 3000)
PORT=3000
