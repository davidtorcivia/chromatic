# Chromatic Environment Configuration
# Copy this file to .env and fill in required values.

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# Admin authentication token (generate with: openssl rand -hex 32)
ADMIN_TOKEN=

# Public browser URL (no trailing slash)
PUBLIC_URL=https://stream.yourdomain.com

# Domain used by Caddy for TLS certificates
DOMAIN=stream.yourdomain.com

# Deployment image (pin sha-<commit> or digest for production)
CHROMATIC_IMAGE=ghcr.io/davidtorcivia/chromatic:latest

# =============================================================================
# TURN CONFIGURATION
# =============================================================================

# TURN mode:
# - external   (recommended default, no self-hosted coturn required)
# - hybrid     (self-hosted coturn + external provider)
# - self-hosted
TURN_MODE=external

# Cloudflare TURN (recommended for TURN_MODE=external)
TURN_CLOUDFLARE_KEY_ID=
TURN_CLOUDFLARE_API_TOKEN=

# Optional custom TURN URL list (comma-separated). Leave blank to auto-use
# Cloudflare defaults when Cloudflare credentials are configured.
TURN_EXTERNAL_URLS=

# Optional static external TURN credentials (Twilio/Xirsys/Metered/etc.)
TURN_EXTERNAL_USER=
TURN_EXTERNAL_PASS=

# Legacy single-URL variable kept for compatibility (optional)
TURN_EXTERNAL_URL=

# Self-hosted coturn settings (required for TURN_MODE=hybrid/self-hosted)
TURN_SECRET=
TURN_REALM=stream.yourdomain.com
PUBLIC_IP=

# =============================================================================
# PRODUCTION SETTINGS
# =============================================================================

PRODUCTION_MODE=true
ALLOWED_ORIGINS=https://stream.yourdomain.com
TRUSTED_PROXIES=

# =============================================================================
# STORAGE PATHS
# =============================================================================

DATABASE_PATH=/data/chromatic.db
UPLOAD_PATH=/data/files
LOGO_PATH=/data/logos

# =============================================================================
# SERVER SETTINGS
# =============================================================================

PORT=3000

# =============================================================================
# TIMEOUTS
# =============================================================================

OBS_RECONNECT_TIMEOUT=5m
CLIENT_PING_INTERVAL=60s

